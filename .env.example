# Copy this file to ".env" and fill in only what you plan to use.
# NEVER publish ".env" (it is already in .gitignore).

# Active AI provider: hermes | nvidia | groq | openrouter | deepseek | gemini | openai
JARVIS_PROVIDER=hermes

NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional: local Hermes gateway (the key is Hermes' API_SERVER_KEY, not a provider key).
# HERMES_API_SERVER_KEY=
# HERMES_API_BASE_URL=http://127.0.0.1:8642/v1
# HERMES_MODEL=hermes-agent
# HERMES_CLI_PATH=
# Hermes Desktop shortcut used by the "open Hermes" command (default: Desktop\Hermes.lnk).
# HERMES_SHORTCUT_PATH=

# Optional: local Google OAuth (Calendar and read-only Gmail).
# Authorized redirect URI: http://127.0.0.1:3000/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN and GOOGLE_SCOPE_VERSION are written by the "Connect Google" flow; do not fill them in by hand.

PORT=3000

# Optional: paths different from the defaults.
# SEARCH_PLUS_DIR=../msearch-plus
# JARVIS_VOICE_STUDIO_DIR=./jarvis-voice-studio
# JARVIS_PYTHON=C:\Python313\python.exe
